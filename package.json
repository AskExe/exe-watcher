{
  "name": "exe-watcher",
  "version": "0.2.74",
  "description": "The owl watching your AI coding spend \u2014 cost, tokens, agents, and projects in your terminal and menu bar",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "exe-watcher": "dist/cli.js"
  },
  "files": [
    "dist",
    "vendor/odd-core-analytics",
    "THIRD_PARTY_NOTICES.md",
    "!dist/**/*.map",
    "vendor/odd-core-recovery"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest",
    "test:release": "node --test mac/Scripts/publish-release.test.mjs",
    "release:mac": "node mac/Scripts/publish-release.mjs",
    "prepublishOnly": "npm run build && npm run release:mac"
  },
  "keywords": [
    "claude-code",
    "cursor",
    "codex",
    "opencode",
    "pi",
    "ai-coding",
    "token-usage",
    "cost-tracking",
    "observability",
    "developer-tools"
  ],
  "engines": {
    "node": ">=22.13.0 <23 || >=23.4.0"
  },
  "author": "Exe AI <hello@askexe.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AskExe/exe-watcher.git"
  },
  "bugs": {
    "url": "https://github.com/AskExe/exe-watcher/issues"
  },
  "homepage": "https://github.com/AskExe/exe-watcher#readme",
  "dependencies": {
    "@noble/ciphers": "^2.0.1",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@supabase/supabase-js": "^2.108.1",
    "bip39": "^3.1.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "ink": "^7.0.0",
    "react": "^19.2.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@odd-core/analytics": "file:vendor/odd-core-analytics",
    "@odd-core/recovery": "file:vendor/odd-core-recovery",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.14",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
